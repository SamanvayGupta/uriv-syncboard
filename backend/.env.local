# ══════════════════════════════════════════════════════════════
#  SyncBoard Backend — Local Development .env
#  Copy this file to backend/.env
# ══════════════════════════════════════════════════════════════

# PostgreSQL (started by Docker — or change to your local DB)
DATABASE_URL=postgresql+asyncpg://syncboard:syncboard_secret@localhost:5432/syncboard

# OCR Engine: "tesseract" (easy install) or "paddle" (heavier, more accurate)
OCR_ENGINE=tesseract

# Minimum word confidence to include in output (0–100)
MIN_CONFIDENCE=30

# Board-clear detection threshold (fraction of changed pixels, 0–1)
CLEAR_THRESHOLD=0.05

# CORS — add your frontend URL here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
