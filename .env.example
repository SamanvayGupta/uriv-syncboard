# ══════════════════════════════════════════════════════════════
#  SyncBoard — .env.example
#  Copy to .env and fill in your values.
# ══════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=syncboard
POSTGRES_PASSWORD=syncboard_secret
POSTGRES_DB=syncboard

# ── Backend ────────────────────────────────────────────────────
# Full async connection string (auto-built by docker-compose)
DATABASE_URL=postgresql+asyncpg://syncboard:syncboard_secret@postgres:5432/syncboard

# OCR engine: paddle (recommended) | tesseract (fallback)
OCR_ENGINE=paddle

# Word confidence floor 0-100
MIN_CONFIDENCE=40

# Fraction of changed pixels to declare board "cleared" (0-1)
CLEAR_THRESHOLD=0.05

# ── Frontend ───────────────────────────────────────────────────
VITE_WS_URL=ws://localhost:8000/ws
VITE_API_URL=http://localhost:8000

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
